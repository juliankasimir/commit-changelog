{
  "name": "commit-changelog",
  "version": "1.0.0",
  "description": "Automatic HTML changelog generation from Conventional Commits",
  "scripts": {
    "changelog": "conventional-changelog -p angular -i CHANGELOG.md -s",
    "changelog:html": "node scripts/generate-html-changelog.js"
  },
  "devDependencies": {
    "conventional-changelog-cli": "^4.1.0",
    "conventional-changelog-angular": "^6.0.0",
    "lefthook": "^1.7.0",
    "markdown-it": "^14.0.0"
  }
}
